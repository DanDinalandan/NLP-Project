frontend/src-tauri/binaries/*.exe
# Rust/Tauri build output
frontend/src-tauri/target/

# ── Node ──────────────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local

# ── Logs ──────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── User data (never in repo) ─────────────────────────────────
*.sqlite
*.db
chroma/

# ── AI session meta-files ─────────────────────────────────────
NEXT_SESSION.md

# ── Editor ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
.idea
.DS_Store
