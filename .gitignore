# ── Secrets ───────────────────────────────────────────────────
backend/.env
.env

# ── Python ────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
# PyInstaller local build artifacts (sidecar is built by CI, not committed)
backend/build/
backend/dist/

# ── Tauri ─────────────────────────────────────────────────────
